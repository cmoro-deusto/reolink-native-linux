# Maintainer: cmoro-deusto
# Contributor: TodesengelX (original author of the upstream project)
#
# Builds the code of the checkout this PKGBUILD lives in — the working tree as
# it is, uncommitted changes included — not a downloaded release. From the
# repo root:  cd packaging/aur && makepkg -si

_repo="$(realpath "$startdir/../..")"

pkgname=reolink-native-linux
# e.g. 0.2.0.r3.g1a2b3c4: last tag, commits since it, current commit. Computed
# here rather than in pkgver() so makepkg doesn't rewrite this file each build.
pkgver=$(git -C "$_repo" describe --long --tags --abbrev=7 2>/dev/null \
  | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g')
pkgver=${pkgver:-0.0.0}
pkgrel=1
pkgdesc="Native Linux desktop client for Reolink cameras and NVRs (Qt6, no Wine/Electron)"
arch=('x86_64')
url="https://github.com/cmoro-deusto/reolink-native-linux"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'ffmpeg' 'curl' 'libsecret' 'sqlite')
makedepends=('cmake' 'git' 'qt6-shadertools' 'qt6-tools')

build() {
  cmake -S "$_repo" -B build -G "Unix Makefiles" -Wno-dev \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build -j"$(nproc)"
}

check() {
  # Headless, with a private runtime dir for the single-instance socket test.
  mkdir -p "$srcdir/rt" && chmod 700 "$srcdir/rt"
  QT_QPA_PLATFORM=offscreen XDG_RUNTIME_DIR="$srcdir/rt" \
    ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
